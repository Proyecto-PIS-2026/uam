  {
    "id": "data_migration.completar_especie_variedad_publicaciones",
    "label": "Conservar especie y variedad de las publicaciones existentes",
    "operationClass": "data",
    "target": {
      "id": "postgres"
    },
    "precheck": [],
    "execute": [
      {
        "description": "Copiar la especie y variedad antes de permitir atributos vacíos",
        "sql": "UPDATE \"public\".\"publicacion\" AS publicacion\nSET \"especieId\" = variedad.\"especieId\", \"variedadId\" = variedad.\"id\"\nFROM \"public\".\"presentacion\" AS presentacion\nJOIN \"public\".\"variedad\" AS variedad ON variedad.\"id\" = presentacion.\"variedadId\"\nWHERE publicacion.\"presentacionId\" = presentacion.\"id\";"
      }
    ],
    "postcheck": []
  },
