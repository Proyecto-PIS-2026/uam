  {
    "id": "data.catalogos_envases_kilos_calibres",
    "label": "Cargar envases, kilos del empaquetado y calibres generales",
    "operationClass": "data",
    "target": {
      "id": "postgres"
    },
    "precheck": [],
    "execute": [
      {
        "description": "Cargar envases independientes de la especie y la variedad",
        "sql": "INSERT INTO \"public\".\"envase\" (\"nombreEnvase\")\nVALUES ('Plancha'), ('Cajon'), ('Cajita'), ('Bolsa'), ('Descartable'), ('Bing'), ('Bins')\nON CONFLICT (\"nombreEnvase\") DO NOTHING;"
      },
      {
        "description": "Cargar cantidades y rangos de kilos preestablecidos",
        "sql": "INSERT INTO \"public\".\"kilosEmpaquetado\" (\"valor\")\nVALUES ('2'), ('4'), ('8'), ('10'), ('18'), ('20'), ('22'), ('25'), ('250'), ('400'), ('10-12'), ('18-24')\nON CONFLICT (\"valor\") DO NOTHING;"
      },
      {
        "description": "Agregar calibres disponibles para todas las publicaciones",
        "sql": "INSERT INTO \"public\".\"calibre\" (\"codigoCalibre\", \"nombreCalibre\")\nVALUES ('Primera', 'Primera'), ('Segunda', 'Segunda'), ('Tercera', 'Tercera'),\n('Cuarta', 'Cuarta'), ('Quinta', 'Quinta'), ('Sexta', 'Sexta'),\n('0', '0'), ('00', '00'), ('Especial', 'Especial')\nON CONFLICT (\"codigoCalibre\") DO UPDATE SET \"nombreCalibre\" = EXCLUDED.\"nombreCalibre\";"
      }
    ],
    "postcheck": []
  }
]